# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trading_stack
DATABASE_ECHO=false
# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
# Environment
ENVIRONMENT=development
# Security (change in production)
SECRET_KEY=change-this-to-a-random-secret-key-in-production
# MT5 bridge connection
# Host/port of the HTTP bridge process that wraps the MT5 terminal
# (see app/services/mt5_client.py for the expected bridge contract).
MT5_HOST=
MT5_PORT=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
